# Neon (Postgres gratis). Copiá las URLs después de crear la base:
#   npx neon-new@latest --yes --env .env.local --seed db/schema.sql
#
# O creá un proyecto en https://neon.tech / https://supabase.com
# y pegá acá el connection string.

DATABASE_URL=
